{
  "name": "irongate-city",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@irongate/server --filter=@irongate/client",
    "dev:mem": "concurrently -k -n db,apps,worker -c gray,cyan,magenta \"pnpm db:mem\" \"pnpm dev:mem:apps\" \"pnpm dev:mem:worker\"",
    "dev:mem:apps": "cross-env PORT=3001 DB_MODE=memory MONGODB_URI=mongodb://127.0.0.1:27018/irongate?directConnection=true PUBLIC_ORIGIN=http://localhost:5173 BETTER_AUTH_SECRET=dev-mem-only-secret-never-use-in-production E2E_TEST_HOOKS=1 turbo run dev --filter=@irongate/server --filter=@irongate/client",
    "dev:mem:worker": "cross-env DB_MODE=memory MONGODB_URI=mongodb://127.0.0.1:27018/irongate?directConnection=true PUBLIC_ORIGIN=http://localhost:5173 BETTER_AUTH_SECRET=dev-mem-only-secret-never-use-in-production pnpm --filter @irongate/server dev:worker",
    "dev:worker": "pnpm --filter @irongate/server dev:worker",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:mem": "pnpm --filter @irongate/db mem",
    "seed": "pnpm --filter @irongate/db seed",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "art:build": "tsx scripts/art/build.ts",
    "art:check": "tsx scripts/art/build.ts --check",
    "report:playtest": "pnpm --filter @irongate/db report:playtest",
    "admin:boost": "pnpm --filter @irongate/db admin:boost"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "catalog:",
    "turbo": "^2.11.5",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server",
      "sharp"
    ]
  }
}
