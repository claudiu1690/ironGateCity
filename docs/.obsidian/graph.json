    { "query": "path:wiki/history", "color": { "a": 1, "rgb": 10066329 } },
    { "query": "path:wiki/runbooks", "color": { "a": 1, "rgb": 13408512 } },
    { "query": "path:wiki/questions", "color": { "a": 1, "rgb": 14431557 } },
    { "query": "path:adr", "color": { "a": 1, "rgb": 6710937 } },
    { "query": "file:GDD", "color": { "a": 1, "rgb": 16766720 } }
