generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Faction {
  FASCIST
  COMMUNIST
  DEMOCRAT
}

enum MissionType {
  TRAINING
  INTELLIGENCE
  PROPAGANDA
  DISRUPTION
  SABOTAGE
  POLITICAL
  SOCIAL
  OPERATION
  COUNCIL
  JOB
}

enum MissionOutcome {
  SUCCESS
  PARTIAL_SUCCESS
  FAILURE
  ENCOUNTER_WIN
  ENCOUNTER_LOSS
}

enum ItemSlot {
  WEAPON
  ARMOUR
  UTILITY
  ACCESSORY
  DOCUMENT
}

enum DossierCategory {
  POLITICAL
  CRIMINAL
  LOCATION
  ASSET
  UNCLEAR
}

enum ElectionStatus {
  NOMINATION
  VOTING
  CONCLUDED
}

enum LawStatus {
  PROPOSED
  ACTIVE
  EXPIRED
  REJECTED
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum Weather {
  CLEAR
  RAIN
  FOG
  SNOW
  HEAT_WAVE
  FROST
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?
  isPremium        Boolean   @default(false)
  premiumUntil     DateTime?
  stripeCustomerId String?
  character        Character?
}

// ─── Character ───────────────────────────────────────────────────────────────

model Character {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  name          String
  nickname      String?
  faction       Faction
  currentCityId String
  currentCity   City      @relation(fields: [currentCityId], references: [id])

  // Core stats
  level         Int       @default(1)
  xp            Int       @default(0)
  str           Int       @default(10)
  int           Int       @default(10)
  agi           Int       @default(1)
  factionRank   Int       @default(1)
  factionXp     Int       @default(0)

  // Resources
  maxHealth     Int       @default(100)
  currentHealth Int       @default(100)
  ironMarks     Int       @default(0)

  // Charisma (recalculated on equip; stored as cache)
  charisma      Int       @default(2)

  // Physical condition
  lastFedAt     DateTime  @default(now())
  lastRestedAt  DateTime  @default(now())
  isHospitalised       Boolean   @default(false)
  hospitalisedUntil    DateTime?

  // Criminal record
  criminalPoints Int      @default(0)
  lastOffenceAt  DateTime?

  // Job
  currentJobId  String?
  currentJob    Job?      @relation(fields: [currentJobId], references: [id])
  lastJobDoneAt DateTime?
  jobAbsences   Int       @default(0)

  // Origin Story
  originStoryComplete Boolean  @default(false)

  // Relations
  energy          EnergyState?
  equipment       EquipmentSlots?
  inventory       PlayerInventory[]
  dossier         DossierEntry[]
  bodyguards      Bodyguard[]
  missionHistory  MissionLog[]
  votes           ElectionVote[]
  candidacies     Candidate[]
  createdAt       DateTime @default(now())
}

// ─── Energy ──────────────────────────────────────────────────────────────────

model EnergyState {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id])
  current     Int       @default(100)
  max         Int       @default(100)
  lastTickAt  DateTime  @default(now())
}

// ─── Cities ──────────────────────────────────────────────────────────────────

model City {
  id              String         @id @default(cuid())
  name            String         @unique
  slug            String         @unique
  influenceWeight Int
  influence       CityInfluence?
  characters      Character[]
  missions        Mission[]
  jobs            Job[]
  dossierEntries  DossierEntry[]
}

model CityInfluence {
  id           String   @id @default(cuid())
  cityId       String   @unique
  city         City     @relation(fields: [cityId], references: [id])
  fascistPct   Float    @default(33.33)
  communistPct Float    @default(33.33)
  democratPct  Float    @default(33.34)
  updatedAt    DateTime @updatedAt
}

// ─── Missions ────────────────────────────────────────────────────────────────

model Mission {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String
  type            MissionType
  faction         Faction?
  cityId          String
  city            City        @relation(fields: [cityId], references: [id])
  energyCost      Int
  minLevel        Int         @default(1)
  minFactionRank  Int         @default(1)
  minCha          Int         @default(0)
  minAgi          Int         @default(0)
  minStr          Int         @default(0)
  xpReward        Int
  fxpReward       Int         @default(0)
  ironReward      Int
  encounterChance Float       @default(0)
  influenceGain   Float       @default(0)
  dossierReward   Boolean     @default(false)
  logs            MissionLog[]
}

model MissionLog {
  id          String         @id @default(cuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id])
  missionId   String
  mission     Mission        @relation(fields: [missionId], references: [id])
  outcome     MissionOutcome
  xpAwarded   Int
  ironAwarded Int
  fxpAwarded  Int
  rngSeed     String
  createdAt   DateTime       @default(now())
}

// ─── Equipment & Items ───────────────────────────────────────────────────────

model EquipmentSlots {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id])

  weaponId    String?
  armourId    String?
  utilityId   String?
  accessoryId String?
  documentId  String?

  weapon      Item?     @relation("weapon",    fields: [weaponId],    references: [id])
  armour      Item?     @relation("armour",    fields: [armourId],    references: [id])
  utility     Item?     @relation("utility",   fields: [utilityId],   references: [id])
  accessory   Item?     @relation("accessory", fields: [accessoryId], references: [id])
  document    Item?     @relation("document",  fields: [documentId],  references: [id])
}

model Item {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  slot          ItemSlot
  tier          Int
  faction       Faction?
  strBonus      Int      @default(0)
  intBonus      Int      @default(0)
  chaBonus      Int      @default(0)
  defBonus      Int      @default(0)
  fxpBonus      Float    @default(0)
  missionBonus  Float    @default(0)
  description   String
  acquireMethod String
  ironCost      Int      @default(0)

  // Reverse relations for each equipment slot
  weaponSlots    EquipmentSlots[] @relation("weapon")
  armourSlots    EquipmentSlots[] @relation("armour")
  utilitySlots   EquipmentSlots[] @relation("utility")
  accessorySlots EquipmentSlots[] @relation("accessory")
  documentSlots  EquipmentSlots[] @relation("document")

  inventory PlayerInventory[]
}

model PlayerInventory {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  acquiredAt  DateTime  @default(now())
}

// ─── Dossier ─────────────────────────────────────────────────────────────────

model DossierEntry {
  id          String          @id @default(cuid())
  characterId String
  character   Character       @relation(fields: [characterId], references: [id])
  category    DossierCategory
  subjectName String
  content     String
  cityId      String
  city        City            @relation(fields: [cityId], references: [id])
  isStale     Boolean         @default(false)
  createdAt   DateTime        @default(now())
  expiresAt   DateTime
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model Job {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  tier            Int
  energyCost      Int
  minLevel        Int         @default(1)
  minStr          Int         @default(0)
  minInt          Int         @default(0)
  minAgi          Int         @default(0)
  minFactionRank  Int         @default(0)
  ironMinPay      Int
  ironMaxPay      Int
  cityId          String?
  city            City?       @relation(fields: [cityId], references: [id])
  requiresTravel  Boolean     @default(true)
  characters      Character[]
}

// ─── Bodyguards ──────────────────────────────────────────────────────────────

model Bodyguard {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  tier        Int
  dailyCost   Int
  hiredAt     DateTime  @default(now())
  active      Boolean   @default(true)
}

// ─── Political Engine ────────────────────────────────────────────────────────

model Election {
  id             String         @id @default(cuid())
  faction        Faction
  status         ElectionStatus
  nominationEnds DateTime
  votingEnds     DateTime
  winnerId       String?
  candidates     Candidate[]
  votes          ElectionVote[]
  createdAt      DateTime       @default(now())
}

model Candidate {
  id          String    @id @default(cuid())
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  manifesto   String?
  voteWeight  Int       @default(0)
}

model ElectionVote {
  id          String   @id @default(cuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id])
  voterId     String
  voter       Character @relation(fields: [voterId], references: [id])
  candidateId String
  signature   String
  createdAt   DateTime @default(now())

  @@unique([electionId, voterId])
}

model ActivePresident {
  id           String   @id @default(cuid())
  characterId  String   @unique
  faction      Faction
  termEnds     DateTime
  lawsProposed Int      @default(0)
}

model Law {
  id           String    @id @default(cuid())
  title        String
  description  String
  category     String
  effect       Json
  proposedBy   String
  status       LawStatus
  votesFor     Int       @default(0)
  votesAgainst Int       @default(0)
  activatedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

// ─── NPC Enemy Templates ─────────────────────────────────────────────────────

model NpcTemplate {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  faction  Faction?
  str      Int
  hp       Int
  minLevel Int      @default(1)
  special  String?  // e.g. 'debuff_accuracy' — parsed by combat resolver
}

// ─── Weather ─────────────────────────────────────────────────────────────────

model WeatherState {
  id      String   @id @default(cuid())
  season  Season
  weather Weather
  date    DateTime @default(now())
}
