# Copy to apps/client/.env.local only if you need to override something.

# Same-origin API through the Vite proxy in dev/preview and the Vercel rewrite in production (ADR 0001).
# Only set an absolute URL for the cross-origin fallback (tech design §12).
VITE_API_BASE=/api

# Optional: leave empty to disable Sentry in the browser.
VITE_SENTRY_DSN=

# Not read from this file: API_PROXY_TARGET is a shell variable for vite.config.ts
# (default http://127.0.0.1:3001), e.g. `API_PROXY_TARGET=http://127.0.0.1:3101 pnpm preview`.
