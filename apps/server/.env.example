# Copy to apps/server/.env. Validated at start-up by src/env.ts (a bad value fails with its name).
# `pnpm dev:mem` does not need this file; `pnpm dev` (Docker) and `pnpm seed` do.

NODE_ENV=development
PORT=3001
# Loopback for local dev (the default). The Dockerfile sets 0.0.0.0 for Railway/Fly.
HOST=127.0.0.1

# uri    = connect to MONGODB_URI (Docker `pnpm db:up`, `pnpm db:mem`, or Atlas)
# memory = start an in-memory replica set inside the server process (e2e, quick demos; data is lost on exit)
DB_MODE=uri
# Docker (docker-compose.yml):
MONGODB_URI=mongodb://127.0.0.1:27017/irongate?replicaSet=rs0&directConnection=true
# pnpm db:mem:     mongodb://127.0.0.1:27018/irongate?replicaSet=rs0&directConnection=true
# Atlas:           mongodb+srv://<user>:<password>@<cluster>/irongate?retryWrites=true&w=majority

# At least 32 characters. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret

# The origin the BROWSER sees: the Vite dev server locally, the Vercel URL in production (ADR 0001)
PUBLIC_ORIGIN=http://localhost:5173

# Proxies in front of the API, so the auth rate limit sees the player's IP (default 2: the Vercel
# /api rewrite, then the Railway/Fly edge). A hop count, or a comma list of proxy IPs/CIDRs.
# An assumption until the first deploy: see apps/server/src/env.ts.
# TRUST_PROXY=2

# Optional: leave empty to disable Sentry
SENTRY_DSN=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional: reported by /healthz (defaults to the package version)
# APP_VERSION=
